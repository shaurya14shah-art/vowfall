      "root": "REFLECTION",
      "name": "The Twin",
      "thesis": "What is done to one is done to its twin.",
      "text": "Bind two that stand near each other. Harm done to either is done again to the other, at three fifths. So is healing. Six echoes, then the bond is spent. Part them far enough and it breaks.",
      "operation": "BIND",
      "tier": "TECHNIQUE",
      "scope": {"shape": "PAIR"},
      "term": {"ticks": 720, "events": 6},
      "price": {"resonance": 30},
      "condition": [{"pred": "PAIR_WITHIN", "reach": 900}],
      "breach": [{"type": "PAIR_SEPARATED", "reach": 1500}, {"type": "PAIR_MEMBER_DOWN"}],
      "counterplay": ["SEPARATE", "EXHAUST", "TURN_IT"],
      "clauses": [
        {
          "id": "copy",
          "on": ["HARM", "HEAL"], "stage": "REACT", "op": "TRANSFER", "counts": true,
          "params": {"mode": "COPY_TO_PAIR", "pct": 60, "tag": "copied"},
          "where": {"pair": "TARGET_IN_PAIR", "tags": {"none": ["copied"]}},
          "reason": "what is done to one is done to its twin"
        }
      ],
      "unveiled": {
        "text": "The twin receives the whole of it, and distance no longer parts them.",
        "breach": [{"type": "PAIR_MEMBER_DOWN"}],
        "clauses": [
          {
            "id": "copy",
            "on": ["HARM", "HEAL"], "stage": "REACT", "op": "TRANSFER", "counts": true,
            "params": {"mode": "COPY_TO_PAIR", "pct": 100, "tag": "copied"},
            "where": {"pair": "TARGET_IN_PAIR", "tags": {"none": ["copied"]}},
            "reason": "what is done to one is done to its twin"
          }
        ]
      }
    },
    {
