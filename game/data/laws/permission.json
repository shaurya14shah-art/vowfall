      "version": 1,
      "root": "PERMISSION",
      "name": "Warrant",
      "thesis": "The bearer may pass.",
      "text": "Carried by Court bailiffs. The bearer's next two strikes or steps may not be denied by any law less narrow than this one.",
      "operation": "PRESERVE",
      "tier": "TECHNIQUE",
      "scope": {"shape": "SELF"},
      "term": {"ticks": 600, "events": 2},
      "price": {"resonance": 20},
      "breach": [],
      "counterplay": ["EXHAUST", "OUTRANK", "OUTLAST"],
      "clauses": [
        {
          "id": "may_pass",
          "on": ["STRIKE", "MOVE"], "stage": "GATES", "op": "PRESERVE", "counts": true,
          "where": {"source": {"rel": "OWNER"}},
          "reason": "the bearer may pass"
        }
      ]
    },
    {
      "id": "court.escort",
      "version": 1,
      "root": "PERMISSION",
      "name": "Escort",
      "thesis": "The escorted may pass.",
      "text": "Binds a bailiff and a ward. Strikes and steps by either may not be denied, unless a law of equal standing contests it.",
      "operation": "PRESERVE",
