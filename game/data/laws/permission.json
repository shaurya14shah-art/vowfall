{
  "laws": [
    {
      "id": "voss.writ_of_standing",
      "version": 1,
      "root": "PERMISSION",
      "name": "Writ of Standing",
      "thesis": "No one may strike the Arbiter unseen.",
      "text": "A strike made by hand against the Arbiter from behind is denied, and the one who made it is sanctioned.",
      "operation": "DENY",
      "tier": "TECHNIQUE",
      "scope": {"shape": "FIELD"},
      "term": {"ticks": 900},
      "price": {"resonance": 20},
      "breach": [],
      "counterplay": ["FACE_HIM", "USE_LAWS_NOT_HANDS", "OUTLAST"],
      "clauses": [
        {
          "id": "deny_unseen",
          "on": ["STRIKE"], "stage": "DENY", "op": "DENY",
          "params": {"sanction": 8},
          "where": {"target": {"rel": "OWNER"}, "tags": {"all": ["by_hand", "from_behind"]}},
          "reason": "the Arbiter did not see it struck"
        }
      ]
    },
    {
      "id": "voss.writ_of_order",
      "version": 1,
      "root": "PERMISSION",
      "name": "Writ of Order",
      "thesis": "None may strike thrice unanswered.",
      "text": "The third strike of any string made by hand against the Arbiter is denied, and the one who made it is sanctioned.",
      "operation": "DENY",
      "tier": "TECHNIQUE",
      "scope": {"shape": "FIELD"},
      "term": {"ticks": 900},
      "price": {"resonance": 20},
      "breach": [],
      "counterplay": ["SHORT_STRINGS", "USE_LAWS_NOT_HANDS", "OUTLAST"],
      "clauses": [
        {
          "id": "deny_third",
          "on": ["STRIKE"], "stage": "DENY", "op": "DENY",
          "params": {"sanction": 6},
          "where": {"target": {"rel": "OWNER"}, "tags": {"all": ["by_hand"]}, "data": [{"key": "combo_index", "gte": 3}]},
          "reason": "it was struck a third time unanswered"
        }
      ]
    },
    {
      "id": "voss.writ_of_licence",
      "version": 1,
      "root": "PERMISSION",
      "name": "Writ of Licence",
      "thesis": "No law may be imposed without licence.",
      "text": "No one the Arbiter has not recognised may impose a law. Whoever answers one of his blows with a perfect parry is recognised for ten seconds.",
      "operation": "DENY",
      "tier": "TECHNIQUE",
      "scope": {"shape": "FIELD"},
      "term": {"ticks": 900},
      "price": {"resonance": 30},
      "breach": [],
      "counterplay": ["EARN_STANDING", "OUTLAST"],
      "clauses": [
        {
          "id": "recognise",
          "on": ["STRIKE"], "stage": "NOTICE", "op": "ALTER",
          "params": {"tag_add": {"who": "TARGET", "tag": "recognised", "ticks": 600}},
          "where": {"source": {"rel": "OWNER"}, "tags": {"all": ["perfect_parry"]}},
          "reason": "the Arbiter recognises one who answers him"
        },
        {
          "id": "deny_unlicensed",
          "on": ["IMPOSE"], "stage": "DENY", "op": "DENY",
          "where": {"source": {"rel": "HOSTILE", "none": ["recognised"]}},
          "reason": "no law may be imposed without licence"
        }
      ]
    },
    {
      "id": "voss.the_hearing",
      "version": 1,
      "root": "PERMISSION",
      "name": "The Hearing",
      "thesis": "No argument may be made twice.",
      "text": "EDICT. For the next nine acts made by hand, no one may repeat their own last act. Whoever does is denied and sanctioned. This binds the Arbiter too.",
      "operation": "DENY",
      "tier": "EDICT",
      "scope": {"shape": "FIELD"},
      "term": {"ticks": 1800, "events": 9},
      "price": {"resonance": 60},
      "breach": [],
      "counterplay": ["VARY_ACTS", "EXHAUST", "USE_LAWS_NOT_HANDS"],
      "clauses": [
        {
          "id": "hear",
          "on": ["STRIKE"], "stage": "NOTICE", "op": "REVEAL", "counts": true,
          "where": {"tags": {"all": ["by_hand"]}, "first_of_swing": true},
          "reason": "an act is heard"
        },
        {
          "id": "deny_repeat",
          "on": ["STRIKE"], "stage": "DENY", "op": "DENY",
          "params": {"sanction": 10},
          "where": {"tags": {"all": ["by_hand"]}, "same_act_as_last": true},
          "reason": "the same argument was made twice"
        }
      ]
    },
    {
