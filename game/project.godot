; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="VOWFALL"
config/description="Third-person action RPG. Power is a personal law."
run/main_scene="res://scenes/Arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://gameplay/input_setup.gd"
Sfx="*res://presentation/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
scaling_3d/mode=1
scaling_3d/scale=0.67
environment/defaults/default_clear_color=Color(0.86, 0.83, 0.76, 1)
